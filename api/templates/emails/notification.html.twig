{% trans_default_domain 'emails' %}
<p><strong>{{ content.categoryLabel ?? content.category.label }}</strong></p>
<h1 style="font-size:20px">{{ content.title }}</h1>
<p style="white-space:pre-line">{{ content.body }}</p>
<p><a href="{{ url }}">{{ 'notification.view'|trans }}</a></p>
<hr>
<p style="font-size:12px;color:#666">{{ 'notification.why'|trans }} <a href="{{ preferencesUrl }}">{{ 'notification.preferences'|trans }}</a></p>
