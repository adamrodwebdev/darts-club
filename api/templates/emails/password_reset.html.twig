{% trans_default_domain 'emails' %}
<p>{{ 'greeting'|trans }}</p>
{% if by_administrator %}
<p>{{ 'password_reset.intro_admin'|trans }}</p>
{% else %}
<p>{{ 'password_reset.intro'|trans }}</p>
{% endif %}
<p><a href="{{ link }}">{{ 'password_reset.button'|trans }}</a></p>
<p>{{ 'password_reset.expires'|trans }}</p>
{% if by_administrator %}
<p>{{ 'password_reset.ignore_admin'|trans }}</p>
{% else %}
<p>{{ 'password_reset.ignore'|trans }}</p>
{% endif %}
