{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$SERVER_NAME:localhost} {
	# Compression : zstd et Brotli si le navigateur les accepte, sinon gzip
	encode zstd br gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		-Server
	}

	# Temps réel : hub Mercure servi sur la même origine (cookies SameSite)
	handle /.well-known/mercure* {
		reverse_proxy {$MERCURE_UPSTREAM:mercure:80}
	}

	# API Symfony
	handle /api/* {
		# Taille des requêtes bornée avant PHP : 1 Mo, sauf les envois de fichiers
		# (photos : 10 de 10 Mo ; affiche, avatar, justificatif d'un bilan : 10 Mo)
		@photos path_regexp ^/api/events/[^/]+/photos$
		@file path_regexp ^/api/(events/[^/]+/(poster|accounts/receipts)|me/avatar)$
		@small not path_regexp ^/api/(events/[^/]+/(photos|poster|accounts/receipts)|me/avatar)$
		request_body @photos {
			max_size 112MB
		}
		request_body @file {
			max_size 11MB
		}
		request_body @small {
			max_size 1MB
		}
		root * /app/public
		rewrite * /index.php
		php
	}

	# Front Vue (application monopage)
	handle {
		root * /app/web

		# Fichiers versionnés par Vite (nom avec empreinte) : cache d'un an
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Enregistrement de l'hymne : lu par plages (Range), gardé une semaine (renommer le fichier s'il change)
		@audio path /audio/*
		header @audio Cache-Control "public, max-age=604800"
		@other not path /assets/* /audio/*
		header @other Cache-Control "no-cache"

		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-3bfSnBFBSEZLh3JBULgCCFhdAI+P+orU0+xQBCgnQmo=' 'sha256-zZTt4bBHZ6K3utXiPgFX3i9VrKUB6BNSJU6sL98kSdo='; style-src 'self' 'sha256-Adt85b8YRQRtycBLV9sHG9wpLm2lPWLZ5R8uL3Gw+ws='; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
			X-Frame-Options "DENY"
			Cross-Origin-Opener-Policy "same-origin"
		}

		try_files {path} {path}.html /index.html
		file_server
	}
}

# Variante « www » : redirection permanente vers le domaine principal (certificat obtenu aussi)
www.{$SERVER_NAME:localhost} {
	redir https://{$SERVER_NAME:localhost}{uri} permanent
}
