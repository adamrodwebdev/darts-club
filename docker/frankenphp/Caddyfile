{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
		# Le site ne lance jamais de programme (ffmpeg tourne dans le worker, en ligne de commande, où ce
		# réglage ne s'applique pas) : une faille d'exécution de code PHP ne peut ni ouvrir un shell, ni
		# lancer un programme (mail() et putenv() servent à contourner cette liste par LD_PRELOAD)
		php_ini disable_functions exec,passthru,shell_exec,system,proc_open,popen,pcntl_exec,mail,mb_send_mail,putenv
	}
}

{$SERVER_NAME:localhost} {
	# Compression : zstd et Brotli si le navigateur les accepte, sinon gzip ; jamais le flux
	# temps réel (Server-Sent Events), que la compression retarderait
	@compressible not path /.well-known/mercure*
	encode @compressible zstd br gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		-Server
	}

	# Temps réel : hub Mercure servi sur la même origine (cookies SameSite)
	handle /.well-known/mercure* {
		reverse_proxy {$MERCURE_UPSTREAM:mercure:80}
	}

	# API Symfony
	handle /api/* {
		# Taille des requêtes bornée avant PHP : 1 Mo, sauf les envois de fichiers
		# (photos : 10 de 10 Mo ; affiche, avatar, justificatif d'un bilan, attestation d'assurance,
		# morceau de vidéo de 8 Mo : 10 Mo)
		@photos path_regexp ^/api/events/[^/]+/photos$
		@file path_regexp ^/api/(events/[^/]+/(poster|accounts/receipts)|me/avatar|association-profile/insurance|event-videos/[^/]+/chunks/[0-9]+)$
		@small not path_regexp ^/api/(events/[^/]+/(photos|poster|accounts/receipts)|me/avatar|association-profile/insurance|event-videos/[^/]+/chunks/[0-9]+)$
		request_body @photos {
			max_size 112MB
		}
		request_body @file {
			max_size 11MB
		}
		request_body @small {
			max_size 1MB
		}
		root * /app/public
		rewrite * /index.php
		php
	}

	# Front Vue (application monopage)
	handle {
		root * /app/web

		# Fichiers versionnés par Vite (nom avec empreinte) : cache d'un an
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Enregistrement de l'hymne : lu par plages (Range), gardé une semaine (renommer le fichier s'il change)
		@audio path /audio/*
		header @audio Cache-Control "public, max-age=604800"
		@other not path /assets/* /audio/*
		header @other Cache-Control "no-cache"

		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-3bfSnBFBSEZLh3JBULgCCFhdAI+P+orU0+xQBCgnQmo=' 'sha256-zZTt4bBHZ6K3utXiPgFX3i9VrKUB6BNSJU6sL98kSdo='; style-src 'self' 'sha256-Lm7FClr8jF2SVRY5T8FF3BbLQQZbtz04/qFWFSaa4pc='; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
			X-Frame-Options "DENY"
			Cross-Origin-Opener-Policy "same-origin"
		}

		try_files {path} {path}.html /index.html
		file_server
	}
}

# Variante « www » : redirection permanente vers le domaine principal (certificat obtenu aussi)
www.{$SERVER_NAME:localhost} {
	redir https://{$SERVER_NAME:localhost}{uri} permanent
}
