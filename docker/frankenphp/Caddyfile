{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$SERVER_NAME:localhost} {
	# Compression : zstd et Brotli si le navigateur les accepte, sinon gzip
	encode zstd br gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		-Server
	}

	# Temps réel : hub Mercure servi sur la même origine (cookies SameSite)
	handle /.well-known/mercure* {
		reverse_proxy {$MERCURE_UPSTREAM:mercure:80}
	}

	# API Symfony
	handle /api/* {
		root * /app/public
		rewrite * /index.php
		php
	}

	# Front Vue (application monopage)
	handle {
		root * /app/web

		# Fichiers versionnés par Vite (nom avec empreinte) : cache d'un an
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Enregistrement de l'hymne : lu par plages (Range), gardé une semaine (renommer le fichier s'il change)
		@audio path /audio/*
		header @audio Cache-Control "public, max-age=604800"
		@other not path /assets/* /audio/*
		header @other Cache-Control "no-cache"

		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-3bfSnBFBSEZLh3JBULgCCFhdAI+P+orU0+xQBCgnQmo=' 'sha256-0uZDfW5Prrhqt72xZtDWAXYa60+pNCdY9cioGz0Mv1g='; style-src 'self' 'sha256-2C96fSUZMXLdOAk91JZbp/Gb7N6zcLVtqGLO8M81j+Y='; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
			X-Frame-Options "DENY"
			Cross-Origin-Opener-Policy "same-origin"
		}

		try_files {path} {path}.html /index.html
		file_server
	}
}

# Variante « www » : redirection permanente vers le domaine principal (certificat obtenu aussi)
www.{$SERVER_NAME:localhost} {
	redir https://{$SERVER_NAME:localhost}{uri} permanent
}
