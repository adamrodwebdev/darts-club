# Modèle du fichier /opt/skull-darts-71/.env sur le serveur (chmod 600).
# Ne jamais commiter le vrai fichier. Commandes de génération : docs/deploiement.md

# Domaine (sans https://) ; Caddy obtient le certificat HTTPS automatiquement
SERVER_NAME=skulldarts71.fr

# Image publiée par GitHub Actions ; IMAGE_TAG=latest ou un SHA de commit (retour arrière)
IMAGE=ghcr.io/adamrodwebdev/darts-club
IMAGE_TAG=latest

# Secrets de l'application
APP_SECRET=
# 32 octets en base64 — NE JAMAIS CHANGER sans réchiffrer les secrets 2FA
TWO_FACTOR_ENCRYPTION_KEY=
MERCURE_JWT_SECRET=

# Base de données (mot de passe hexadécimal : pas de caractère à échapper dans l'URL)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Emails (Brevo, SMTP) : smtp://IDENTIFIANT:CLE_SMTP@smtp-relay.brevo.com:587
MAILER_DSN=
MAILER_FROM=no-reply@skulldarts71.fr

# Notifications push (bin/console app:push:generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bureau@skulldarts71.fr

# Connexion Google / Discord (facultatif : boutons inactifs si vide)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# Sauvegardes chiffrées (deploy/backup.sh) : clé publique age du bureau
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/skull-darts-71
BACKUP_RETENTION_DAYS=30
